# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# real utility bills contain names/addresses: never commit them
/eval/bills/private/

# UI UX Pro Max tool files (we commit the design system it generates, not the tool)
/.claude/skills/ui-ux-pro-max/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/data/raw/

# eval: cached raw model outputs (re-scoring is free); results are committed
/eval/cache/
